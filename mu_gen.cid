<?xml version="1.0" encoding="utf-8"?>
<!--Mergin unit genérica - Autor Ezequiel Rabelo de Aguiar, CEMIG GT = 08/04/2026-->
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" xmlns:sxy="http://www.iec.ch/61850/2003/SCLcoordinates" version="2007" revision="B" release="4">
  <Header id="MU_GENERICA" revision="A" version="4" toolID="MANUAL" nameStructure="IEDName">
    <History>
      <Hitem revision="A" version="1" who="ZECRUEL" what="MU GENERICA" why="Publicar SV" when="2026-04-03" />
    </History>
  </Header>
  <Communication>
    <SubNetwork name="Processo" type="8-MMS">
      <ConnectedAP iedName="MU_GEN" apName="Pr">
        <SMV ldInst="Mestre" cbName="SV_Vao">
          <Address>
            <P type="MAC-Address">01-0C-CD-04-09-82</P>
            <P type="VLAN-ID">0B8</P>
            <P type="VLAN-PRIORITY">5</P>
            <P type="APPID">5402</P>
          </Address>
        </SMV>
      </ConnectedAP>
    </SubNetwork>
  </Communication>
  <IED name="MU_GEN" manufacturer="" configVersion="" originalSclVersion="2007" originalSclRevision="B" originalSclRelease="4" desc="MU_GEN">
    <Services>
      <ConfDataSet maxAttributes="100" max="1" modify="0"/>
      <ReadWrite/>
      <SMVsc max="2"/>
    </Services>
    <AccessPoint name="Pr">
      <Server>
        <Authentication/>
        <LDevice inst="Mestre" ldName="MU_GEN_Mestre" desc="Mestre">
          <LN0 lnType="LLN0_CEMIG" lnClass="LLN0" inst="">
            <DataSet name="SVVao">
              <!-- Corrente TC Vm -->
              <FCDA ldInst="TC_" prefix="VM_" lnClass="TCTR" lnInst="1" doName="AmpSv" daName="instMag.i" fc="MX"></FCDA>
              <FCDA ldInst="TC_" prefix="VM_" lnClass="TCTR" lnInst="1" doName="AmpSv" daName="q" fc="MX"></FCDA>
              <!-- Corrente TC Az -->
              <FCDA ldInst="TC_" prefix="AZ_" lnClass="TCTR" lnInst="1" doName="AmpSv" daName="instMag.i" fc="MX"></FCDA>
              <FCDA ldInst="TC_" prefix="AZ_" lnClass="TCTR" lnInst="1" doName="AmpSv" daName="q" fc="MX"></FCDA>
              <!-- Corrente TC Br -->
              <FCDA ldInst="TC_" prefix="BR_" lnClass="TCTR" lnInst="1" doName="AmpSv" daName="instMag.i" fc="MX"></FCDA>
              <FCDA ldInst="TC_" prefix="BR_" lnClass="TCTR" lnInst="1" doName="AmpSv" daName="q" fc="MX"></FCDA>
              <!-- Corrente TC N -->
              <FCDA ldInst="TC_" prefix="N_" lnClass="TCTR" lnInst="1" doName="AmpSv" daName="instMag.i" fc="MX"></FCDA>
              <FCDA ldInst="TC_" prefix="N_" lnClass="TCTR" lnInst="1" doName="AmpSv" daName="q" fc="MX"></FCDA>
              <!-- Tensão no TP Vm -->
              <FCDA ldInst="TP_" prefix="VM_" lnClass="TVTR" lnInst="1" doName="VolSv" daName="instMag.i" fc="MX"></FCDA>
              <FCDA ldInst="TP_" prefix="VM_" lnClass="TVTR" lnInst="1" doName="VolSv" daName="q" fc="MX"></FCDA>
              <!-- Tensão no TP Az -->
              <FCDA ldInst="TP_" prefix="AZ_" lnClass="TVTR" lnInst="1" doName="VolSv" daName="instMag.i" fc="MX"></FCDA>
              <FCDA ldInst="TP_" prefix="AZ_" lnClass="TVTR" lnInst="1" doName="VolSv" daName="q" fc="MX"></FCDA>
              <!-- Tensão no TP Br -->
              <FCDA ldInst="TP_" prefix="BR_" lnClass="TVTR" lnInst="1" doName="VolSv" daName="instMag.i" fc="MX"></FCDA>
              <FCDA ldInst="TP_" prefix="BR_" lnClass="TVTR" lnInst="1" doName="VolSv" daName="q" fc="MX"></FCDA>
              <!-- Tensão no TP N -->
              <FCDA ldInst="TP_" prefix="N_" lnClass="TVTR" lnInst="1" doName="VolSv" daName="instMag.i" fc="MX"></FCDA>
              <FCDA ldInst="TP_" prefix="N_" lnClass="TVTR" lnInst="1" doName="VolSv" daName="q" fc="MX"></FCDA>
            </DataSet>
            <SampledValueControl name="SV_Vao" datSet="SVVao" confRev="1" smvID="SV_Vao_MU_GEN" smpRate="80" multicast="true" nofASDU="1" smpMod="SmpPerPeriod">
              <SmvOpts sampleRate="false" sampleSynchronized="true" refreshTime="false" dataSet="false" security="false"></SmvOpts>
            </SampledValueControl>
          </LN0>
          <LN prefix="STATUS_" lnClass="LPHD" inst="1" lnType="LPHD_CEMIG" desc="STATUS_1" />
        </LDevice>
        <LDevice inst="TC_" ldName="MU_GEN_TC_" desc="TC_">
          <LN0 lnType="LLN0_CEMIG" lnClass="LLN0" inst="" />
          <LN prefix="VM_" lnClass="TCTR" inst="1" lnType="TCTR_CEMIG" desc="VM_1"/>
          <LN prefix="AZ_" lnClass="TCTR" inst="1" lnType="TCTR_CEMIG" desc="AZ_1"/>
          <LN prefix="BR_" lnClass="TCTR" inst="1" lnType="TCTR_CEMIG" desc="BR_1"/>
          <LN prefix="N_" lnClass="TCTR" inst="1" lnType="TCTR_CEMIG" desc="N_1"/>
        </LDevice>
        <LDevice inst="TP_" ldName="MU_GEN_TP_" desc="TP_">
          <LN0 lnType="LLN0_CEMIG" lnClass="LLN0" inst="" />
          <LN prefix="VM_" lnClass="TVTR" inst="1" lnType="TVTR_CEMIG" desc="VM_1"/>
          <LN prefix="AZ_" lnClass="TVTR" inst="1" lnType="TVTR_CEMIG" desc="AZ_1"/>
          <LN prefix="BR_" lnClass="TVTR" inst="1" lnType="TVTR_CEMIG" desc="BR_1"/>
          <LN prefix="N_" lnClass="TVTR" inst="1" lnType="TVTR_CEMIG" desc="N_1"/>
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>
  <!-- == Padrões de Estruturas de dados == -->
  <DataTypeTemplates>
    <LNodeType id="LLN0_CEMIG" lnClass="LLN0">
      <DO name="NamPlt" type="LPL" desc="Nome do LD" />
      <DO name="Beh" type="ENS_Beh" desc="Status do modo (N/T/B)" />
      <DO name="Health" type="ENS_heal" desc="Indicador de saúde" />
      <DO name="Mod" type="ENS_mod" desc="Seta o modo (N/T/B)" />
      <DO name="LocKey" type="SPS" desc="Local/Remoto" />
    </LNodeType>
    <LNodeType id="LPHD_CEMIG" lnClass="LPHD">
      <DO name="PhyNam" type="DPL" desc="Identificação do IED (Modelo, Fabr, etc)" />
      <DO name="PhyHealth" type="ENS_ied" desc="Saúde do IED" />
      <DO name="Proxy" type="SPS" desc="IED como proxy" />
      <DO name="NamVariant" type="9-2NamVariant"/>
      <DO name="NamHzRtg" type="9-2NamHzRtg"/>
    </LNodeType>
    <LNodeType id="TCTR_CEMIG" lnClass="TCTR">
      <DO name="Beh" type="ENS_Beh" desc="Status do modo (N/T/B)" />
      <DO name="AmpSv" type="SAV" desc="Corrente no TC - fase" />
      <DO name="EEHealth" type="ENS_heal" desc="Saúde do enrolamento do TC (enrolamento aberto)" />
    </LNodeType>
    <LNodeType id="TVTR_CEMIG" lnClass="TVTR">
      <DO name="Beh" type="ENS_Beh" desc="Status do modo (N/T/B)" />
      <DO name="FuFail" type="SPS" desc="Minidisjuntor ou fusível aberto no TP Vm" />
      <DO name="VolSv" type="SAV" desc="Tensão no TP - fase" />
    </LNodeType>
    <DOType id="DPC" cdc="DPC">
      <DA name="stVal" bType="Dbpos" fc="ST" dchg="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
      <DA name="ctlModel" bType="Enum" fc="CF" dchg="true" />
    </DOType>
    <DOType id="DPL" cdc="DPL">
      <DA name="vendor" bType="VisString255" fc="DC" />
      <DA name="model" bType="VisString255" fc="DC" />
      <DA name="name" bType="VisString255" fc="DC" />
      <DA name="owner" bType="VisString255" fc="DC" />
    </DOType>
    <DOType id="ENS_Beh" cdc="ENS">
      <DA name="stVal" bType="Enum" fc="ST" dchg="true" dupd="true" type="Enum_Beh" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="ENS_heal" cdc="ENS">
      <DA name="stVal" bType="Enum" fc="ST" dchg="true" dupd="true" type="Enum_heal" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="ENS_ied" cdc="ENS">
      <DA name="stVal" bType="Enum" fc="ST" dchg="true" dupd="true" type="Enum_ied" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="ENS_mod" cdc="ENS">
      <DA name="stVal" bType="Enum" fc="ST" dchg="true" dupd="true" type="Enum_mod" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="INS" cdc="INS">
      <DA name="stVal" bType="INT32" fc="ST" dchg="true" dupd="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="LPL" cdc="LPL">
      <DA name="vendor" bType="VisString255" fc="DC" />
      <DA name="swRev" bType="VisString255" fc="DC" />
      <DA name="configRev" bType="VisString255" fc="DC" />
    </DOType>
    <DOType id="MV" cdc="MV">
      <DA name="mag" bType="Struct" fc="MX" dchg="true" dupd="true" type="AnalogueValue" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="SAV" cdc="SAV">
      <DA name="instMag" bType="Struct" fc="MX" type="AnalogueValue" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="SPC" cdc="SPC">
      <DA name="ctlModel" bType="Enum" fc="CF" dchg="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="SPS" cdc="SPS">
      <DA name="stVal" bType="BOOLEAN" fc="ST" dchg="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="9-2NamVariant" cdc="VSD">
			<DA name="val" bType="VisString255" fc="DC">
				<Val>F4800S1I4U4</Val>
			</DA>
			<DA name="d" bType="VisString255" fc="DC">
				<Val>a semicolon separated list of the variant codes supported, the codes as being as defined in IEC 61869-9:2014 clause 6.903.2</Val>
			</DA>
			<DA name="dataNs" bType="VisString255" fc="EX">
				<Val>IEC 61869-9:2016</Val>
			</DA>
		</DOType>
		<DOType id="9-2NamHzRtg" cdc="VSD">
			<DA name="val" bType="VisString255" fc="DC">
				<Val>60</Val>
			</DA>
			<DA name="d" bType="VisString255" fc="DC">
				<Val>a semicolon separated list of the nominal frequencies (fR) supported, in Hertz</Val>
			</DA>
			<DA name="dataNs" bType="VisString255" fc="EX">
				<Val>IEC 61869-9:2016</Val>
			</DA>
		</DOType>
    <DAType id="AnalogueValue">
      <BDA name="i" bType="INT32" />
      <BDA name="f" bType="FLOAT32" />
    </DAType>
    <DAType id="ValWithTrans">
      <BDA name="posVal" bType="INT8" />
      <BDA name="transInd" bType="BOOLEAN" />
    </DAType>
    <DAType id="Vector">
      <BDA name="mag" bType="Struct" type="AnalogueValue" />
      <BDA name="ang" bType="Struct" type="AnalogueValue" />
    </DAType>
    <!-- * Behaviour _ Status do modo (N/T/B) * -->
    <EnumType id="Enum_Beh">
      <EnumVal ord="1">on</EnumVal>
      <EnumVal ord="2">blocked</EnumVal>
      <EnumVal ord="3">test</EnumVal>
      <EnumVal ord="4">test/blocked</EnumVal>
      <EnumVal ord="5">off</EnumVal>
    </EnumType>
    <!-- * Health _ Indicador de saúde * -->
    <EnumType id="Enum_heal">
      <EnumVal ord="1">Ok</EnumVal>
      <EnumVal ord="2">Warning</EnumVal>
      <EnumVal ord="3">Alarm</EnumVal>
    </EnumType>
    <!-- * PhyHealth _ Indicador de saúde do IED * -->
    <EnumType id="Enum_ied">
      <EnumVal ord="1">Ok</EnumVal>
      <EnumVal ord="2">Warning</EnumVal>
      <EnumVal ord="3">Alarm</EnumVal>
    </EnumType>
    <!-- * Controle do modo (N/T/B) * -->
    <EnumType id="Enum_mod">
      <EnumVal ord="1">on</EnumVal>
      <EnumVal ord="2">blocked</EnumVal>
      <EnumVal ord="3">test</EnumVal>
      <EnumVal ord="4">test/blocked</EnumVal>
      <EnumVal ord="5">off</EnumVal>
    </EnumType>
  </DataTypeTemplates>
</SCL>