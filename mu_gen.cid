      <DO name="AnIn7" type="MV" desc="Entrada analógica sinal genérico 7" />
      <DO name="AnIn8" type="MV" desc="Entrada analógica sinal genérico 8" />
    </LNodeType>
    <LNodeType id="LLN0_CEMIG" lnClass="LLN0">
      <DO name="NamPlt" type="LPL" desc="Nome do LD" />
      <DO name="Beh" type="ENS_Beh" desc="Status do modo (N/T/B)" />
      <DO name="Health" type="ENS_heal" desc="Indicador de saúde" />
      <DO name="Mod" type="ENS_mod" desc="Seta o modo (N/T/B)" />
      <DO name="LocKey" type="SPS" desc="Local/Remoto" />
    </LNodeType>
    <LNodeType id="LPHD_CEMIG" lnClass="LPHD">
      <DO name="PhyNam" type="DPL" desc="Identificação do IED (Modelo, Fabr, etc)" />
      <DO name="PhyHealth" type="ENS_ied" desc="Saúde do IED" />
      <DO name="Proxy" type="SPS" desc="IED como proxy" />
    </LNodeType>
    <LNodeType id="TCTR_CEMIG" lnClass="TCTR">
      <DO name="Beh" type="ENS_Beh" desc="Status do modo (N/T/B)" />
      <DO name="AmpSv" type="SAV" desc="Corrente no TC - fase" />
      <DO name="EEHealth" type="ENS_heal" desc="Saúde do enrolamento do TC (enrolamento aberto)" />
    </LNodeType>
    <LNodeType id="TVTR_CEMIG" lnClass="TVTR">
      <DO name="Beh" type="ENS_Beh" desc="Status do modo (N/T/B)" />
      <DO name="FuFail" type="SPS" desc="Minidisjuntor ou fusível aberto no TP Vm" />
      <DO name="VolSv" type="SAV" desc="Tensão no TP - fase" />
    </LNodeType>
    <DOType id="DPC" cdc="DPC">
      <DA name="stVal" bType="Dbpos" fc="ST" dchg="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
      <DA name="ctlModel" bType="Enum" fc="CF" dchg="true" />
    </DOType>
    <DOType id="DPL" cdc="DPL">
      <DA name="vendor" bType="VisString255" fc="DC" />
      <DA name="model" bType="VisString255" fc="DC" />
      <DA name="name" bType="VisString255" fc="DC" />
      <DA name="owner" bType="VisString255" fc="DC" />
    </DOType>
    <DOType id="ENS_Beh" cdc="ENS">
      <DA name="stVal" bType="Enum" fc="ST" dchg="true" dupd="true" type="Enum_Beh" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="ENS_heal" cdc="ENS">
      <DA name="stVal" bType="Enum" fc="ST" dchg="true" dupd="true" type="Enum_heal" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="ENS_ied" cdc="ENS">
      <DA name="stVal" bType="Enum" fc="ST" dchg="true" dupd="true" type="Enum_ied" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="ENS_mod" cdc="ENS">
      <DA name="stVal" bType="Enum" fc="ST" dchg="true" dupd="true" type="Enum_mod" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="INS" cdc="INS">
      <DA name="stVal" bType="INT32" fc="ST" dchg="true" dupd="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="LPL" cdc="LPL">
      <DA name="vendor" bType="VisString255" fc="DC" />
      <DA name="swRev" bType="VisString255" fc="DC" />
      <DA name="configRev" bType="VisString255" fc="DC" />
    </DOType>
    <DOType id="MV" cdc="MV">
      <DA name="mag" bType="Struct" fc="MX" dchg="true" dupd="true" type="AnalogueValue" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="SAV" cdc="SAV">
      <DA name="instMag" bType="Struct" fc="MX" type="AnalogueValue" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="SPC" cdc="SPC">
      <DA name="ctlModel" bType="Enum" fc="CF" dchg="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DOType id="SPS" cdc="SPS">
      <DA name="stVal" bType="BOOLEAN" fc="ST" dchg="true" />
      <DA name="q" bType="Quality" fc="ST" qchg="true" />
      <DA name="t" bType="Timestamp" fc="ST" />
    </DOType>
    <DAType id="AnalogueValue">
      <BDA name="i" bType="INT32" />
      <BDA name="f" bType="FLOAT32" />
    </DAType>
    <DAType id="ValWithTrans">
      <BDA name="posVal" bType="INT8" />
      <BDA name="transInd" bType="BOOLEAN" />
    </DAType>
    <DAType id="Vector">
      <BDA name="mag" bType="Struct" type="AnalogueValue" />
      <BDA name="ang" bType="Struct" type="AnalogueValue" />
    </DAType>
    <!-- * Behaviour _ Status do modo (N/T/B) * -->
    <EnumType id="Enum_Beh">
      <EnumVal ord="1">on</EnumVal>
      <EnumVal ord="2">blocked</EnumVal>
      <EnumVal ord="3">test</EnumVal>
      <EnumVal ord="4">test/blocked</EnumVal>
      <EnumVal ord="5">off</EnumVal>
    </EnumType>
    <!-- * Health _ Indicador de saúde * -->
    <EnumType id="Enum_heal">
      <EnumVal ord="1">Ok</EnumVal>
      <EnumVal ord="2">Warning</EnumVal>
      <EnumVal ord="3">Alarm</EnumVal>
    </EnumType>
    <!-- * PhyHealth _ Indicador de saúde do IED * -->
    <EnumType id="Enum_ied">
      <EnumVal ord="1">Ok</EnumVal>
      <EnumVal ord="2">Warning</EnumVal>
      <EnumVal ord="3">Alarm</EnumVal>
    </EnumType>
    <!-- * Controle do modo (N/T/B) * -->
    <EnumType id="Enum_mod">
      <EnumVal ord="1">on</EnumVal>
      <EnumVal ord="2">blocked</EnumVal>
      <EnumVal ord="3">test</EnumVal>
      <EnumVal ord="4">test/blocked</EnumVal>
      <EnumVal ord="5">off</EnumVal>
    </EnumType>
  </DataTypeTemplates>
</SCL>